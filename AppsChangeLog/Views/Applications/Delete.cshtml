@model AppsChangeLog.Models.Application

@{
    ViewData["Title"] = "Delete application";
}

<div class="page-header">
    <h1>Delete application</h1>
</div>

<div class="content-panel">
    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <p>Are you sure you want to delete this application?</p>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Version</dt>
        <dd class="col-sm-9">@Model.CurrVersion</dd>

        <dt class="col-sm-3">Vendor</dt>
        <dd class="col-sm-9">@Model.Vendor.Name</dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>