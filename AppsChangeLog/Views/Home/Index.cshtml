@model IEnumerable<AppsChangeLog.Models.Application>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1>Dashboard</h1>
</div>

<div class="content-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Application</th>
                    <th>Current version</th>
                    <th>Vendor</th>
                    <th>Release date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Applications"
                               asp-action="Details"
                               asp-route-id="@application.Id">
                                @application.Name
                            </a>
                        </td>
                        <td>@application.CurrVersion</td>
                        <td>@application.Vendor.Name</td>
                        <td>
                            @application.ReleaseDate.ToString("dd MMM yyyy")
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No applications have been added.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>