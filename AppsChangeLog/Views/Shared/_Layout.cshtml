@inject Microsoft.AspNetCore.Identity.UserManager<AppsChangeLog.Models.User> UserManager
@{
    bool loggedIn = User.Identity?.IsAuthenticated == true;
    var currentUser = loggedIn ? await UserManager.GetUserAsync(User) : null;
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - AppsChangeLog</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    @if (loggedIn)
    {
        <div class="app-layout">
            <aside class="sidebar">
                <a class="sidebar-title"
                   asp-controller="Home"
                   asp-action="Index">
                    AppsChangeLog
                </a>

                <nav class="sidebar-navigation" aria-label="Main navigation">
                    <a class="sidebar-link @(currentController == "Home" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                        Dashboard
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="sidebar-heading">Administration</div>

                        <a class="sidebar-link @(currentController == "Vendors" ? "active" : "")"
                           asp-controller="Vendors"
                           asp-action="Index">
                            Manage vendors
                        </a>

                        <a class="sidebar-link @(currentController == "Users" ? "active" : "")"
                           asp-controller="Users"
                           asp-action="Index">
                            Manage users
                        </a>

                        <a class="sidebar-link @(currentController == "Applications" ? "active" : "")"
                           asp-controller="Applications"
                           asp-action="Index">
                            Manage applications
                        </a>
                    }

                </nav>

                <div class="sidebar-account">
                    <div class="account-name">@currentUser?.FullName</div>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">
                        <button type="submit" class="logout-button">
                            Log out
                        </button>
                    </form>
                </div>
            </aside>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="container py-5">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>